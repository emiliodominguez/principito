{
	"printWidth": 150,
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"endOfLine": "lf",
	"arrowParens": "always",
	"bracketSameLine": false,
	"proseWrap": "preserve",
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{ "files": "*.astro", "options": { "parser": "astro" } },
		{ "files": ["*.yml", "*.yaml"], "options": { "useTabs": false, "tabWidth": 2 } }
	]
}
