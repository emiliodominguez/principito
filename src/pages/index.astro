---
import ChapterNavigation from "#components/ChapterNavigation.astro";
import LoadingScreen from "#components/LoadingScreen.astro";
import StoryExperience from "#components/StoryExperience.astro";
import StoryText from "#components/StoryText.astro";
import { en } from "#i18n/en";
import Base from "#layouts/Base.astro";
---

<Base copy={en} alternate="/es/">
	<a class="visually-hidden" href="#story">
		{en.ui.skipToStory}
	</a>
	<LoadingScreen copy={en} />
	<StoryExperience copy={en} />
	<StoryText copy={en} />
	<ChapterNavigation copy={en} alternate="/es/" />
</Base>
