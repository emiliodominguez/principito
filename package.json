{
	"name": "principito",
	"version": "0.1.0",
	"private": true,
	"description": "An interactive stop-motion storybook made of paper, inspired by The Little Prince.",
	"type": "module",
	"imports": {
		"#engine/*": "./src/engine/*.ts",
		"#chapters/*": "./src/chapters/*.ts",
		"#story/assets-manifest.json": "./src/story/assets-manifest.json",
		"#story/*": "./src/story/*.ts",
		"#i18n/*": "./src/i18n/*.ts",
		"#shaders/*": "./src/shaders/*.ts",
		"#components/*": "./src/components/*",
		"#layouts/*": "./src/layouts/*",
		"#styles/*": "./src/styles/*"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"lint": "pnpm lint:code && pnpm lint:styles",
		"lint:code": "oxlint --deny-warnings .",
		"lint:styles": "stylelint \"src/**/*.scss\" --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "astro check --minimumSeverity warning",
		"test": "vitest run",
		"assets": "pnpm assets:blender && pnpm assets:optimize",
		"assets:blender": "/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup --python blender/generate_assets.py --",
		"assets:optimize": "node scripts/optimize-assets.mjs"
	},
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": "26.x",
		"pnpm": "12.8.1"
	},
	"dependencies": {
		"@fontsource-variable/newsreader": "5.3.0",
		"@vercel/analytics": "2.0.1",
		"gsap": "3.15.0",
		"three": "0.187.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@gltf-transform/core": "4.5.1",
		"@gltf-transform/extensions": "4.5.1",
		"@gltf-transform/functions": "4.5.1",
		"@types/node": "26.6.5",
		"@types/three": "0.187.0",
		"astro": "7.4.4",
		"ktx2-encoder": "0.6.0",
		"meshoptimizer": "1.3.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"postcss-scss": "4.0.9",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"sass": "1.107.1",
		"sharp": "0.35.5",
		"stylelint": "17.16.0",
		"stylelint-config-standard-scss": "17.0.0",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	}
}
